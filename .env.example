# Rustka2 Configuration
# Copy this file to .env and adjust values for your environment
# Most variables have sensible defaults; only set if you need to override them

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================

# Hostname/IP that Kafka clients should use to connect
# 
# IMPORTANT: This must be reachable from your Kafka clients!
#
# Default behavior (if unset):
#   - Automatically detects your primary network interface IP
#   - Usually something like 192.168.x.x or 10.x.x.x
#   - You can check what it detected in the startup logs
#
# When to override:
#   - Docker: Set to container name or host IP (e.g., "localhost" or "rustka")
#   - Kubernetes: Set to Service DNS name (e.g., "rustka-service.default.svc.cluster.local")
#   - Remote access: Set to your machine's hostname or public IP
#   - Port forwarding: Set to the hostname clients will use
#
# Examples:
#   KAFKA_ADVERTISED_HOST=localhost              # Local testing
#   KAFKA_ADVERTISED_HOST=192.168.1.100          # Home network
#   KAFKA_ADVERTISED_HOST=broker.example.com     # Production
#
KAFKA_ADVERTISED_HOST=localhost

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Control verbosity of logging output
#
# Levels (from least to most verbose):
#   - error    : Only critical errors
#   - warn     : Warnings and errors  
#   - info     : Normal operation (DEFAULT)
#   - debug    : Detailed debugging info (recommended for development)
#   - trace    : Very verbose, includes protocol details (not recommended)
#
# Filter by module (colon-separated):
#   RUST_LOG=rustka=debug              # Debug only Rustka code
#   RUST_LOG=debug,kafka_protocol=info # Debug everything except kafka_protocol
#   RUST_LOG=rustka=debug,rustka::storage=trace  # Specific modules
#
# Examples:
#   RUST_LOG=info                      # Default - normal operation
#   RUST_LOG=debug                     # Full debug output (development)
#   RUST_LOG=rustka=debug              # Just Rustka, not dependencies
#
RUST_LOG=info

# ============================================================================
# MEMORY CONFIGURATION (Advanced)
# ============================================================================

# Configure jemalloc memory allocator behavior
#
# Format: comma-separated key=value pairs
# Common settings:
#   dirty_decay_ms  : How long before freed memory is returned to OS (default: 10000 = 10 sec)
#   muzzy_decay_ms  : Memory decay for less-used regions (default: 10000 = 10 sec)
#
# Higher values = Keep more memory in pools for performance
# Lower values = Return memory to OS sooner (if memory-constrained)
#
# Default (set automatically):
#   dirty_decay_ms:10000,muzzy_decay_ms:10000
#
# WARNING: Usually no need to set this. Only for performance tuning!
#
# MALLOC_CONF=dirty_decay_ms:5000,muzzy_decay_ms:5000

# ============================================================================
# PERFORMANCE TUNING (Advanced, rarely needed)
# ============================================================================

# Number of worker threads for the Tokio runtime
# 
# Default: Number of CPU cores on your machine
# 
# Increase if:
#   - Running many concurrent connections
#   - High message throughput needed
#   - CPU not fully utilized
#
# Decrease if:
#   - Running on resource-constrained system
#   - Context switching overhead is high
#
# TOKIO_WORKER_THREADS=4

# ============================================================================
# DEVELOPMENT NOTES
# ============================================================================

# To enable debug logging:
#   $ RUST_LOG=debug make dev
#
# To run with custom advertised host:
#   $ KAFKA_ADVERTISED_HOST=my-broker.local make dev
#
# To check which IP is detected:
#   $ ./target/release/rustka
#   (Check the startup log output)
#
# ============================================================================
